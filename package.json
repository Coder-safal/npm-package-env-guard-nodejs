{
  "name": "@coder-safal/envguard",
  "version": "1.0.1",
  "description": "Type-safe, secret-safe environment validation with zero runtime dependencies",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "API_DECISIONS.md",
    "examples"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node22",
    "package:check": "node scripts/check-package.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm package:check",
    "audit": "pnpm audit --audit-level=low"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "22",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "typescript-minimum": "npm:typescript@5.4.5",
    "vitest": "5.0.5"
  }
}
